AWS_REGION=eu-north-1
AWS_DYNAMODB_TABLE_NAME=Khataapp
# Leave empty on EC2 so the SDK uses the attached IAM role.
AWS_DYNAMODB_ENDPOINT=
# Optional local fallback credentials. Prefer the EC2 instance IAM role in production.
# Uncomment and set these only for local fallback/testing.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
JWT_SECRET=generate-a-strong-random-secret-at-least-32-bytes
JWT_EXPIRATION_MS=3600000
# Comma-separated exact origins. Include the S3 website/CloudFront origin in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
